
@startuml
left to right direction
skinparam shadowing true
skinparam actorStyle "stick"
skinparam usecase {
    BorderColor black
    BackgroundColor white
    ArrowColor black
}

actor Usuario

rectangle "gestion de sumariantes" {
    usecase "registrar sumariantes" as UC1
    usecase "eliminar sumariantes" as UC4
}

Usuario --> UC1
Usuario --> UC4

@enduml
