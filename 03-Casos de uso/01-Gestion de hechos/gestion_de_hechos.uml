
@startuml
left to right direction
skinparam shadowing true
skinparam actorStyle "stick"
skinparam usecase {
    BorderColor black
    BackgroundColor white
    ArrowColor black
}

actor Usuario

rectangle "gestion de hechos" {
    usecase "registrar hecho" as UC1
    usecase "eliminar hecho" as UC2
}

Usuario --> UC1
Usuario --> UC2

@enduml
